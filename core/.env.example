# Credenciales OAuth de Google para la feature Account (sync con Drive).
# Copiá este archivo a `core/.env` y completá según las plataformas que uses.

# ── Desktop ──────────────────────────────────────────────────────────────────
# OAuth client tipo "Desktop app". Usa PKCE + loopback (127.0.0.1:port).
# El client_secret de un client Desktop no es confidencial; si tu client no lo
# requiere, podés dejarlo vacío.
VITE_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=

# ── Android ──────────────────────────────────────────────────────────────────
# OAuth client tipo "Android" (package name + SHA-1 fingerprint). NO lleva
# client_secret. El redirect URI se deriva del ID:
#   com.googleusercontent.apps.<ID-sin-el-sufijo>:/oauth2redirect
# El mismo scheme va en el intent-filter de
# `src-tauri/gen/android/app/src/main/AndroidManifest.xml`.
# Setup en Cloud Console: ver `.claude/knowledge/AndroidOAuth.md`.
VITE_GOOGLE_CLIENT_ID_ANDROID=...apps.googleusercontent.com
