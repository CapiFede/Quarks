{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos del core (desktop). Incluye control de ventana para el titlebar propio (decorations: false), autostart y OAuth loopback. Android usaría una capability propia (crear capabilities/android.json cuando se porte).",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",

    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",

    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",

    "updater:default",
    "process:allow-restart",


    "oauth:allow-start",
    "oauth:allow-cancel",

    "deep-link:default",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",

    "clipboard-manager:allow-read-image",

    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" }
      ]
    },

    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://accounts.google.com/*" },
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    },

    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://oauth2.googleapis.com/*" },
        { "url": "https://www.googleapis.com/*" },
        { "url": "https://openidconnect.googleapis.com/*" },
        { "url": "https://openrouter.ai/*" },
        { "url": "https://**" }
      ]
    }
  ]
}
